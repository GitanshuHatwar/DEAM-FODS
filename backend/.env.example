# ============================================================
# DEAM Industrial Ticketing System — Backend Environment
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
# Project URL — from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role secret key — from: Supabase Dashboard → Project Settings → API
# This key bypasses RLS. Keep it strictly server-side.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-key

# ----------------------------------------------------------
# Gemini AI
# ----------------------------------------------------------
# Your Gemini API key — from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your-gemini-key

# Model to use for AI triage
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------------------------------------
# Backend Server
# ----------------------------------------------------------
# Allowed CORS origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Maximum image upload size in bytes (default: 1 MB)
MAX_IMAGE_BYTES=1048576

# ----------------------------------------------------------
# Frontend (Vite) — create a separate frontend/.env.local
# These are NOT read by the backend; listed here for reference.
# ----------------------------------------------------------
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
