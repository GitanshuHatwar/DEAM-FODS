# Backend REST + SSE base URL
VITE_API_URL=http://localhost:8000

# Supabase Auth credentials (public anon key only; RLS denies direct DB access)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to "true" during frontend-only development to run against src/lib/mocks/
# Set to "false" when connecting to the live FastAPI backend
VITE_USE_MOCKS=true
